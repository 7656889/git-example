# 统一换行符：仓库里一律存 LF，检出到 Windows 时自动转 CRLF
* text=auto eol=lf

# 明确文本类型
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# Windows 脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制，不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary

# 在 GitHub 上把语言统计识别为 HTML 项目
*.html linguist-detectable=true
*.css  linguist-detectable=true
*.js   linguist-detectable=true
*.md   linguist-documentation=true